# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
venv/
.venv/

# IDE
.idea/
*.iml
.vscode/

# Logs
*.log

# Android
android/app/build/
android/.gradle/
android/local.properties

# Models (keep .pt for Android, ignore large .pth backups)
*.pth
# 但 webapp_v2/models/ 下运行所需的小 .pth 权重需要入库
!webapp_v2/models/*.pth
# webapp_v2/models/ 下废弃的旧权重不入库
webapp_v2/models/best_model_v2.pth
# webapp_v2 的 AST 七分类权重（329MB，超过 GitHub 100MB 限制，通过 GitHub Releases 分发）
# 注意：Android 目录下的 .pt 仍保留入库
webapp_v2/models/*.pt

# OS
.DS_Store
Thumbs.db
